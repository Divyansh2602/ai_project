# Copy to backend/.env and adjust. Never commit the real file.

# Local mode (no database server, no Redis): SQLite and inline tasks
DATABASE_URL=sqlite:///./trustsphere.db
CELERY_ALWAYS_EAGER=true
# PostgreSQL + Redis mode instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# REDIS_URL=redis://localhost:6379
# CELERY_ALWAYS_EAGER=false

UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600
HF_HUB_DISABLE_XET=1

# Pre-trained deepfake classifier used for the supporting Grad-CAM evidence
DEEPFAKE_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model

# Signing and blockchain anchoring (anchoring is skipped when the wallet is not set)
SIGNING_KEY_PATH=keys/server_signing_key.pem
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_PRIVATE_KEY=
TRUSTSPHERE_CONTRACT_ADDRESS=
# Set to off to never send a transaction (for tests and demos), even when a wallet is configured
TRUSTSPHERE_ANCHOR=on

# Optional local-LLM summary (off by default)
ENABLE_LLM_SUMMARY=0
